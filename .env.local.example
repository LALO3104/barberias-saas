# Copiar este archivo a .env.local y completar cuando se conecte el backend
# real de Supabase. Ninguna de estas variables debe llevar valores reales
# en el repositorio.

# Dirección pública del sitio, sin / final. La usan los correos de
# recuperación de contraseña. Se fija al compilar.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio — SOLO servidor. NUNCA como NEXT_PUBLIC_.
# La usa src/lib/supabase/admin.ts para operaciones que se saltan RLS.
# Opcional por ahora: ninguna función de la app la necesita todavía.
SUPABASE_SERVICE_ROLE_KEY=
